# For rehearsing the Docker images on YOUR machine. Not for a real deployment:
# production values live in the host's secret store (Phase 16).
# Create the real file with:  bash scripts/make-env-docker.sh   (it fills in fresh secrets)

POSTGRES_USER=groupsavings
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=groupsavings

# development = emails are printed in the api container's logs, the payment simulator is allowed,
# and the API docs are on. (NODE_ENV=production refuses http:// origins and the simulator.)
NODE_ENV=development
WEB_ORIGIN=http://localhost:4000
API_HOST_PORT=4000

JWT_ACCESS_SECRET=REPLACE_ME
DATA_ENCRYPTION_KEY=REPLACE_ME

PAYMENT_MODE=sandbox
PAYMENT_PROVIDER=simulator
LEGAL_REVIEW_CONFIRMED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
