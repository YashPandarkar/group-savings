POSTGRES_USER=groupsavings
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=groupsavings
DATABASE_URL=postgresql://groupsavings:change_me_local_only@localhost:5432/groupsavings

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

PAYMENT_MODE=sandbox
LEGAL_REVIEW_CONFIRMED=false

# --- Auth ---
# Generate with: openssl rand -hex 32   (must be at least 32 characters)
JWT_ACCESS_SECRET=REPLACE_ME
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Data encryption (bank account numbers) ---
# Generate with: openssl rand -hex 32   (exactly 64 hex characters)
# If you lose this key, encrypted bank details cannot be read. Back it up safely.
DATA_ENCRYPTION_KEY=REPLACE_ME

# --- Payment provider ---
# simulator = fake gateway for local work (default, never allowed in production or live mode)
# razorpay  = real API; needs the three values below (test keys start rzp_test_, live keys rzp_live_)
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Serving the web app from the API (production-style, single origin) ---
# Normally set on the command line when rehearsing, not stored in .env.
# SERVE_WEB=true
# WEB_DIST=/absolute/path/to/apps/web/dist   (default: ../web/dist relative to apps/api)
